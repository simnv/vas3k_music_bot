# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- Required ----------------------------------------------------------------

# From @BotFather.
TELEGRAM_API_TOKEN=
# Without the leading @.
TELEGRAM_BOT_USERNAME=
# Chats the bot answers in, as <chatId>:<playlistName> pairs, comma separated.
# A playlist name containing "music" also turns on audio/video auto-detection
# for that chat, e.g. -1001234567890:my_music,-1009876543210:cinema
TELEGRAM_ALLOW_LIST=

# ---- Telegram endpoint (defaults suit the public API) -------------------------

# Point these at a local telegram-bot-api server to lift the 50MB upload limit.
TELEGRAM_BASE_SCHEMA=https
TELEGRAM_BASE_URL=api.telegram.org
TELEGRAM_BASE_PORT=443

# ---- Optional ----------------------------------------------------------------

# Chat id that receives error reports and per-request source info. Unset = off.
ERROR_NOTIFICATION_TELEGRAM_ID=

# Defaults shown; omit to accept them.
YTDL_LOCATION=/usr/local/bin/yt-dlp
CHUNK_SIZE_MB=50
JOB_MARKER_DIR=/data/jobs
MAX_CONCURRENT_DOWNLOADS=32
MAX_CONCURRENT_DOWNLOADS_PER_CHAT=2

# Comma-separated URL substrings forced onto IPv6.
IPV6_URL_CONTAINS=

# SOCKS proxy, and the URL substrings routed through it. Needed for hosts that
# block datacenter addresses — VK and RuTube for downloads, and Yandex Music,
# whose API answers 451 without it.
YTDL_PROXY=socks5h://xray-vk:1080
YTDL_PROXY_URL_CONTAINS=vk.com,vk.ru,vkvideo.ru,rutube.ru

# ---- Music link resolution ----------------------------------------------------

# Optional. Spotify has no keyless path: its pages are JS-rendered with no og:
# tags and its oEmbed omits the artist. Leave both blank to drop Spotify links;
# everything else still resolves. Create an app at developer.spotify.com.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional. Odesli's keyless tier was withdrawn and now returns
# 401 PUBLIC_API_ACCESS_DEPRECATED, so the bot resolves links itself by default.
# Set a key (request one from developers@song.link) to use Odesli in preference.
ODESLI_API_KEY=
